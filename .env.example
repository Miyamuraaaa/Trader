# Quote providers. Every integration is quote/read-only.
ENABLE_JUPITER=true
ENABLE_RAPTOR=true
ENABLE_RAYDIUM=true
ENABLE_ORCA=true
ENABLE_METEORA=true

# Current Jupiter Developer Platform quote API.
# A free key permits 1 RPS. Leave blank for keyless access at 0.5 RPS.
JUPITER_BASE_URL=https://api.jup.ag/swap/v1
JUPITER_API_KEY=
JUPITER_PLAN=free
JUPITER_MAX_RPS=1
JUPITER_SAFETY_INTERVAL_MS=1050

# Current hosted Raptor public-beta quote API. No API key is currently required.
RAPTOR_BASE_URL=https://raptor-beta.solanatracker.io
RAPTOR_SAFETY_INTERVAL_MS=1000
RAPTOR_MAX_HOPS=4

# Optional one-time quote-only probe for inputMint == outputMint.
# Disabled because hosted circular routing availability may change during beta.
ENABLE_RAPTOR_CIRCULAR=false
ENABLE_RAPTOR_STREAM=true
RAPTOR_STREAM_MAX_SUBSCRIPTIONS=3
MARKET_EVENT_DEBOUNCE_MS=250
EVENT_SCAN_MIN_INTERVAL_MS=500

# Raydium official Trade API. Only GET /compute/swap-base-in is called.
RAYDIUM_BASE_URL=https://transaction-v1.raydium.io
RAYDIUM_SAFETY_INTERVAL_MS=550
RAYDIUM_QUOTE_CONCURRENCY=2

# Orca official API is discovery-only; quotes use direct on-chain Whirlpool state.
ORCA_API_BASE_URL=https://api.orca.so/v2/solana
ORCA_SAFETY_INTERVAL_MS=750
ORCA_QUOTE_CONCURRENCY=2
ORCA_MAX_POOLS_PER_PAIR=5
ENABLE_ORCA_CROSS_POOL=true
ORCA_CROSS_POOL_AMOUNTS_USDC=0.01,0.02,0.05
ORCA_CROSS_POOL_PREFILTER_BPS=30
ORCA_POOL_STATE_TIMEOUT_MS=10000

# Meteora official Data API is discovery-only; quotes use the DLMM SDK.
METEORA_API_BASE_URL=https://dlmm.datapi.meteora.ag
METEORA_SAFETY_INTERVAL_MS=750
METEORA_QUOTE_CONCURRENCY=2
METEORA_MAX_POOLS_PER_PAIR=2
DIRECT_QUOTE_QUEUE_MAX=10

# Cached direct-pool metadata. Pool state used for quotes is still fetched fresh.
POOL_CACHE_TTL_SECONDS=300
DIRECT_POOL_MIN_TVL_USDC=10000

# Read-only Solana RPC (health and ESTIMATED network fees only)
SOLANA_RPC_URL=https://api.mainnet-beta.solana.com
SOLANA_WS_URL=
DIRECT_MARKET_STREAM_MAX_SUBSCRIPTIONS=64
# Optional comma-separated read-only RPC fallbacks.
SOLANA_RPC_URLS=https://api.mainnet-beta.solana.com
# Optional dedicated endpoint used only by construction/simulation/confirmation.
# Falls back to SOLANA_RPC_URL when omitted.
EXECUTION_RPC_URL=
# Optional dedicated execution WebSocket endpoint. If omitted, web3.js derives
# it from EXECUTION_RPC_URL. It is used only for read-only slot/account streams.
EXECUTION_WS_URL=
EXECUTION_RPC_TIMEOUT_MS=1000
EXECUTION_PROVIDER_TIMEOUT_MS=1200
EXECUTION_WS_MAX_SILENCE_MS=4000
EXECUTION_POOL_REFRESH_DEBOUNCE_MS=20
# Standard RPC remains the default. Jito sends only the exact, already-approved
# bytes and never retries or falls back after an ambiguous request.
EXECUTION_SUBMISSION_TRANSPORT=rpc
JITO_BLOCK_ENGINE_URL=https://singapore.mainnet.block-engine.jito.wtf
JITO_BENCHMARK_URLS=https://singapore.mainnet.block-engine.jito.wtf,https://tokyo.mainnet.block-engine.jito.wtf,https://mainnet.block-engine.jito.wtf
JITO_AUTH_KEY=
JITO_SUBMISSION_TIMEOUT_MS=750

# Scanner and paper-estimate settings for a very small dedicated-wallet experiment.
SCAN_AMOUNTS_USDC=0.05,0.10,0.25,0.50,1.00
# Bounded parallel scanner cycles rotate sizes without exceeding per-provider pacing.
TRADE_SIZES_PER_SCAN=1
SCANNER_CONCURRENT_CYCLES=3
HOT_CYCLE_WEIGHT=4
WARM_CYCLE_WEIGHT=2
CORE_CYCLE_WEIGHT=1
DISCOVERY_CYCLE_WEIGHT=1
# Lower-priority public-RPC strategy; it must not starve the five-provider matrix.
ORCA_CROSS_POOL_SCAN_INTERVAL_MS=7500
SCAN_TOKENS=USDC,SOL,USDT
# 5 bps = 0.05%; expected and minimum outputs remain separate.
SLIPPAGE_BPS=5
MIN_NET_PROFIT_USDC=0.0001
MIN_PROFIT_BPS=1
# expected restores the original Jupiter/Raptor quote behavior. Conservative mode
# remains available and requires the provider minimum output to be profitable.
PROFIT_MODE=expected
SCAN_MODE=hot
DISCOVERY_MODE=expanded
DYNAMIC_DISCOVERY_REFRESH_SECONDS=900
DYNAMIC_DISCOVERY_LIMIT=8
DYNAMIC_DISCOVERY_SOURCE_LIMIT=20
ORCA_DYNAMIC_EXECUTION_MAX_TOKENS=6
MIN_TOKEN_LIQUIDITY_USD=100000
MIN_VOLUME_24H_USD=100000
TOKEN_ALLOWLIST=
TOKEN_DENYLIST=
# This only makes a dynamically discovered mint eligible for future validation.
# It never bypasses mint, risk, transaction-inspection, or simulation checks.
ALLOW_DYNAMIC_TOKEN_EXECUTION=true
PREFILTER_SPREAD_BPS=1
SHOW_NEGATIVE_ROUTES=false
SHOW_BELOW_THRESHOLD=false
OPPORTUNITY_EXPIRY_MS=15000
OPPORTUNITY_UPDATE_BPS=0.25
DEBUG=false
VERBOSE_SCAN_OUTPUT=false
DIRECT_DEX_ONLY=false
SCAN_INTERVAL_MS=1000
MAX_QUOTE_AGE_MS=5000
REFERENCE_PRICE_ENABLED=false
EXECUTION_MODE=paper
LIVE_TRADING_ENABLED=false
# Required in addition to LIVE_TRADING_ENABLED before the live worker stays
# active and consumes fresh, execution-eligible Orca handoffs.
LIVE_CONTINUOUS_ENABLED=false
REAL_MONEY_READINESS=NOT_READY
LIVE_MAX_TRANSACTIONS=1
LIVE_EXECUTION_POLL_MS=100
FIRST_LIVE_MAX_INPUT_USDC=0.05
MAX_APPROVED_BLOCKHASH_AGE_MS=10000
# Local dashboard fixture only. It never creates an executor candidate and can
# never submit a transaction. Leave false for normal operation.
MANUAL_APPROVAL_UI_MOCK=false
EXECUTION_CONFIRMATION_COMMITMENT=confirmed
# Optional in PAPER. Outside PAPER, this must match the dedicated signer.
# Scanner-only admission control. Never changes executor quote freshness.
SCANNER_RPC_MAX_CONCURRENCY=2
SCANNER_RPC_MIN_INTERVAL_MS=100
SCANNER_RPC_429_COOLDOWN_MS=2000
SCANNER_RPC_MAX_COOLDOWN_MS=15000
SCANNER_RPC_RECOVERY_SUCCESSES=6
SCANNER_DIRECT_LANE_DEADLINE_MS=1000

BOT_WALLET_ADDRESS=
# Dedicated Solana CLI keypair JSON. Store it OUTSIDE this project directory.
# Never use a Phantom recovery phrase or put secret bytes in .env.
# WSL UNC path format: \\wsl.localhost\Ubuntu\home\<user>\.config\sol-arb-bot\bot.json
BOT_KEYPAIR_PATH=\\wsl.localhost\Ubuntu\home\<user>\.config\sol-arb-bot\bot.json
MAX_TRADE_USDC=0.25
MAX_TRADE_PERCENT=10
MAX_DAILY_LOSS_USDC=0.25
MAX_SINGLE_TRADE_LOSS_USDC=0.05
MAX_TRADES_PER_SESSION=1
MAX_EXECUTION_CONSECUTIVE_FAILURES=2
MAX_SESSION_LOSS_USDC=0.25
MAX_CONCURRENT_EXECUTIONS=1
MIN_SOL_FEE_RESERVE=0.002
MAX_EXECUTION_QUOTE_AGE_MS=1200
RAPTOR_EXECUTION_QUOTE_AGE_MS=1800
EXECUTION_SOL_PRICE_CEILING_USDC=250
MAX_SLOT_DIFFERENCE=8
# Explicit, non-arbitrage dry-run infrastructure validation only.
EXECUTION_VALIDATION_AMOUNT_USDC=0.05
EXECUTION_VALIDATION_INTERMEDIATE_MINT=So11111111111111111111111111111111111111112

# Request resilience and deduplication
HTTP_TIMEOUT_MS=5000
HTTP_MAX_RETRIES=2
QUOTE_CACHE_TTL_MS=1500
PROVIDER_FAILURE_THRESHOLD=3
PROVIDER_COOLDOWN_MS=10000
PROVIDER_HEALTH_INTERVAL_MS=60000

# Priority fee used only in the final simulated transaction. Its compute limit
# is measured by execution:validate; ASSUMED_COMPUTE_UNITS is not used there.
FALLBACK_PRIORITY_FEE_MICROLAMPORTS=20000
# Recent landed-fee sampling occurs in the background. The chosen value is
# bounded, embedded in the inspected transaction, and charged to economics.
EXECUTION_PRIORITY_FEE_MIN_MICROLAMPORTS=1000
EXECUTION_PRIORITY_FEE_MAX_MICROLAMPORTS=100000
EXECUTION_PRIORITY_FEE_PERCENTILE=75
EXECUTION_PRIORITY_FEE_REFRESH_MS=10000
ASSUMED_COMPUTE_UNITS=200000

# Paper-trading ledger only
CONFIRMATION_DELAY_MS=500
PAPER_STARTING_BALANCE_USDC=1
PAPER_MAX_DAILY_LOSS_USDC=2

# Optional venue filters
BUY_DEXES=
SELL_DEXES=
